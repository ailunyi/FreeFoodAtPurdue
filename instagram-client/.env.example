# Server URL (no trailing slash)
SERVER_URL=https://your-server.com

# Must match the server's INGEST_API_KEY in its .env
INGEST_API_KEY=your-secret-key-here

# Instagram credentials (recommended for reliability)
INSTAGRAM_USER=your_instagram_username
INSTAGRAM_PASS=your_instagram_password

# Comma-separated Instagram accounts to watch
WATCH_ACCOUNTS=purduestudentgovernment,purdueaaarcc
